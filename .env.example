# At least one key enables the Q&A chat. Without keys the app still runs (search-only answers).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free
LLM_RPM=25
# Detection thresholds (defaults match the security rules)
TRIAGE_FAIL_THRESHOLD=5
TRIAGE_FAIL_WINDOW_MIN=10
TRIAGE_EXFIL_BYTES=524288000
